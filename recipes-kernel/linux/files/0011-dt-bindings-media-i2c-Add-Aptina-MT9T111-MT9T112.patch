From beb4868c8a313a89d5dab3ffc52fffac21561568 Mon Sep 17 00:00:00 2001
From: Koen Kooi <koen@dominion.thruhere.net>
Date: Sun, 25 Oct 2026 04:36:48 +0100
Subject: [PATCH] dt-bindings: media: i2c: Add Aptina MT9T111/MT9T112

Add a binding for the MT9T111 and MT9T112 camera sensors so they can be
described in the device tree. The sensors have a parallel output bus,
an external clock, three supplies and optional reset and standby GPIOs.

Upstream-Status: Pending
Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
---
 .../bindings/media/i2c/aptina,mt9t112.yaml    | 133 ++++++++++++++++++
 MAINTAINERS                                   |   1 +
 2 files changed, 134 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/media/i2c/aptina,mt9t112.yaml

diff --git a/Documentation/devicetree/bindings/media/i2c/aptina,mt9t112.yaml b/Documentation/devicetree/bindings/media/i2c/aptina,mt9t112.yaml
new file mode 100644
index 000000000..5b50d4895
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/aptina,mt9t112.yaml
@@ -0,0 +1,133 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/aptina,mt9t112.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Aptina MT9T111/MT9T112 3.1 megapixel SoC camera sensor
+
+maintainers:
+  - Koen Kooi <koen@dominion.thruhere.net>
+
+description: |
+  The Aptina (now onsemi) MT9T111 and MT9T112 are 1/4-inch 3.1 megapixel
+  (2048x1536) CMOS image sensors with an integrated image flow processor. They
+  are controlled over I2C and output YUV 4:2:2 or RGB on an 8-bit parallel bus
+  (two clock cycles per pixel).
+
+  The sensor generates its pixel clock with an internal PLL from the external
+  clock (EXTCLK).
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    enum:
+      - aptina,mt9t111
+      - aptina,mt9t112
+
+  reg:
+    description: I2C address, selected by the SAADDR pin.
+    enum:
+      - 0x3c
+      - 0x3d
+
+  clocks:
+    maxItems: 1
+    description: EXTCLK input clock.
+
+  vdd-supply:
+    description: Core digital supply, 1.8 V.
+
+  vddio-supply:
+    description: I/O supply, 1.8 V or 2.8 V.
+
+  vaa-supply:
+    description: Analog supply, 2.8 V.
+
+  reset-gpios:
+    maxItems: 1
+    description: GPIO connected to the active-low RESET_BAR pin.
+
+  standby-gpios:
+    maxItems: 1
+    description: GPIO connected to the active-high STANDBY pin.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+    description: Parallel video output port.
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          bus-type:
+            const: 5
+
+          bus-width:
+            const: 8
+
+          pclk-sample:
+            description:
+              Edge of PIXCLK on which the receiver samples the data. The
+              sensor drives the data so that it can be sampled on this edge.
+            enum: [0, 1]
+            default: 0
+
+          hsync-active:
+            const: 1
+
+          vsync-active:
+            const: 1
+
+          link-frequencies: true
+
+        required:
+          - bus-type
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - vdd-supply
+  - vddio-supply
+  - vaa-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+    #include <dt-bindings/media/video-interfaces.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@3c {
+            compatible = "aptina,mt9t112";
+            reg = <0x3c>;
+            clocks = <&clkout2_ck>;
+            orientation = <0>;
+            vaa-supply = <&cam_2v8>;
+            vdd-supply = <&cam_1v8>;
+            vddio-supply = <&cam_2v8>;
+
+            port {
+                endpoint {
+                    bus-type = <MEDIA_BUS_TYPE_PARALLEL>;
+                    bus-width = <8>;
+                    hsync-active = <1>;
+                    pclk-sample = <0>;
+                    remote-endpoint = <&cssp_in>;
+                    vsync-active = <1>;
+                };
+            };
+        };
+    };
+...
