+/*
+ * The bridge source format must match the video node format, and each frame
+ * must be a whole number of DMA requests.
+ */
+static int cssp_video_link_validate(struct media_link *link)
+{
+	struct video_device *vdev =
+		media_entity_to_video_device(link->sink->entity);
+	struct cssp_camif *c = container_of(vdev, struct cssp_camif, vdev);
+	struct v4l2_subdev_format sfmt = {
+		.pad = CSSP_PAD_SOURCE,
+		.which = V4L2_SUBDEV_FORMAT_ACTIVE,
+	};
+	int ret;
+
+	ret = v4l2_subdev_call_state_active(&c->bridge, pad, get_fmt, &sfmt);
+	if (ret)
+		return ret;
+
+	if (debug_skip_size_check) {
+		dev_warn(c->dev, "debug: frame size check skipped\n");
+	} else if (sfmt.format.code != cssp_src_code(c->cfmt) ||
+		   sfmt.format.width != c->fmt.width ||
+		   sfmt.format.height != c->fmt.height) {
+		dev_dbg(c->dev, "format mismatch: bridge 0x%04x %ux%u, video %p4cc %ux%u\n",
+			sfmt.format.code, sfmt.format.width, sfmt.format.height,
+			&c->fmt.pixelformat, c->fmt.width, c->fmt.height);
+		return -EPIPE;
+	}
+
+	if (c->fmt.sizeimage % c->req_len) {
+		dev_dbg(c->dev, "frame size %u is not a multiple of %u bytes\n",
+			c->fmt.sizeimage, c->req_len);
+		return -EPIPE;
+	}
+
+	return 0;
+}
+
+static const struct media_entity_operations cssp_video_entity_ops = {
+	.link_validate = cssp_video_link_validate,
+};
+
+/* -----------------------------------------------------------------------------
+ * Bridge subdev
+ */
+
+static void cssp_default_mbus_fmt(struct v4l2_mbus_framefmt *fmt)
+{
+	*fmt = (struct v4l2_mbus_framefmt) {
+		.width = CSSP_DEF_WIDTH,
+		.height = CSSP_DEF_HEIGHT,
+		.code = cssp_formats[0].code,
+		.field = V4L2_FIELD_NONE,
+		.colorspace = V4L2_COLORSPACE_SRGB,
+		.ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT,
+		.quantization = V4L2_QUANTIZATION_DEFAULT,
+		.xfer_func = V4L2_XFER_FUNC_DEFAULT,
+	};
+}
+
+static int cssp_bridge_init_state(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state)
+{
+	cssp_default_mbus_fmt(v4l2_subdev_state_get_format(state, CSSP_PAD_SINK));
+	cssp_default_mbus_fmt(v4l2_subdev_state_get_format(state, CSSP_PAD_SOURCE));
+
+	return 0;
+}
+
+static int cssp_bridge_enum_mbus_code(struct v4l2_subdev *sd,
+				      struct v4l2_subdev_state *state,
+				      struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct cssp_camif *c = sd_to_cssp(sd);
+	const struct cssp_format *f;
+
+	if (code->pad == CSSP_PAD_SINK) {
+		f = cssp_nth_format(c, code->index);
+		if (!f)
+			return -EINVAL;
+		code->code = f->code;
+		return 0;
+	}
+
+	/* no conversion: the source carries the code of the sink's entry */
+	if (code->index)
+		return -EINVAL;
+	f = cssp_find_code(c, v4l2_subdev_state_get_format(state,
+							   CSSP_PAD_SINK)->code);
+	if (!f)
+		return -EINVAL;
+	code->code = cssp_src_code(f);
+
+	return 0;
+}
+
+static int cssp_bridge_enum_frame_size(struct v4l2_subdev *sd,
+				       struct v4l2_subdev_state *state,
+				       struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct cssp_camif *c = sd_to_cssp(sd);
+	const struct cssp_format *f;
+	const struct v4l2_mbus_framefmt *sink;
+
+	if (fse->index)
+		return -EINVAL;
+
+	if (fse->pad == CSSP_PAD_SINK) {
+		if (!cssp_find_code(c, fse->code))
+			return -EINVAL;
+		fse->min_width = CSSP_MIN_WIDTH;
+		fse->max_width = CSSP_MAX_WIDTH;
+		fse->min_height = CSSP_MIN_HEIGHT;
+		fse->max_height = CSSP_MAX_HEIGHT;
+		return 0;
+	}
+
+	sink = v4l2_subdev_state_get_format(state, CSSP_PAD_SINK);
+	f = cssp_find_code(c, sink->code);
+	if (!f || fse->code != cssp_src_code(f))
+		return -EINVAL;
+	fse->min_width = sink->width;
+	fse->max_width = sink->width;
+	fse->min_height = sink->height;
+	fse->max_height = sink->height;
+
+	return 0;
+}
+
+static int cssp_bridge_set_fmt(struct v4l2_subdev *sd,
+			       struct v4l2_subdev_state *state,
+			       struct v4l2_subdev_format *format)
+{
+	struct cssp_camif *c = sd_to_cssp(sd);
+	struct v4l2_mbus_framefmt *fmt = &format->format;
+	const struct cssp_format *f;
+
+	/* the source format follows the sink: no scaling, no conversion */
+	if (format->pad == CSSP_PAD_SOURCE)
+		return v4l2_subdev_get_fmt(sd, state, format);
+
+	if (!cssp_find_code(c, fmt->code))
+		fmt->code = cssp_formats[0].code;
+	fmt->width = clamp(fmt->width, CSSP_MIN_WIDTH, CSSP_MAX_WIDTH);
+	fmt->height = clamp(fmt->height, CSSP_MIN_HEIGHT, CSSP_MAX_HEIGHT);
+	fmt->field = V4L2_FIELD_NONE;
+	if (fmt->colorspace == V4L2_COLORSPACE_DEFAULT)
+		fmt->colorspace = V4L2_COLORSPACE_SRGB;
+
+	*v4l2_subdev_state_get_format(state, CSSP_PAD_SINK) = *fmt;
+	*v4l2_subdev_state_get_format(state, CSSP_PAD_SOURCE) = *fmt;
+
+	/* the source pad carries the entry's source code, if it has one */
+	f = cssp_find_code(c, fmt->code);
+	v4l2_subdev_state_get_format(state, CSSP_PAD_SOURCE)->code =
+		cssp_src_code(f);
+
+	return 0;
+}
+
+/*
+ * Called with the bridge state locked. hw_lock is taken only around the
+ * enable pulse, never across a sensor call. After a failed sensor enable
+ * nothing is undone (the sensor stream is not enabled); after each enable
+ * timeout the sensor stream is disabled again before the next try.
+ */
+static int cssp_bridge_enable_streams(struct v4l2_subdev *sd,
+				      struct v4l2_subdev_state *state,
+				      u32 pad, u64 streams_mask)
+{
+	struct cssp_camif *c = sd_to_cssp(sd);
+	unsigned int try;
+	int ret = -EAGAIN;
+
+	if (!c->source)
+		return -ENODEV;
+
+	for (try = 0; try < CSSP_ENABLE_TRIES; try++) {
+		ret = v4l2_subdev_enable_streams(c->source, c->source_pad,
+						 BIT_ULL(0));
+		if (ret)
+			return ret;
+
+		scoped_guard(mutex, &c->hw_lock)
+			ret = cssp_capture_enable(c, true);
+		if (ret != -EAGAIN)
+			break;
+
+		dev_warn(c->dev, "no data from the sensor, try %u of %u\n",
+			 try + 1, CSSP_ENABLE_TRIES);
+		v4l2_subdev_disable_streams(c->source, c->source_pad,
+					    BIT_ULL(0));
+	}
+
+	if (ret && ret != -EAGAIN)
+		v4l2_subdev_disable_streams(c->source, c->source_pad,
+					    BIT_ULL(0));
+
+	/* after the last -EAGAIN the sensor stream is already off */
+	return ret;
+}
+
+static int cssp_bridge_disable_streams(struct v4l2_subdev *sd,
+				       struct v4l2_subdev_state *state,
+				       u32 pad, u64 streams_mask)
+{
+	struct cssp_camif *c = sd_to_cssp(sd);
+
+	scoped_guard(mutex, &c->hw_lock)
+		cssp_capture_enable(c, false);
+
+	/* the sensor may have been unbound while streaming */
+	if (c->source)
+		v4l2_subdev_disable_streams(c->source, c->source_pad,
+					    BIT_ULL(0));
+
+	return 0;
+}
+
+static const struct v4l2_subdev_video_ops cssp_bridge_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops cssp_bridge_pad_ops = {
+	.enum_mbus_code = cssp_bridge_enum_mbus_code,
+	.enum_frame_size = cssp_bridge_enum_frame_size,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = cssp_bridge_set_fmt,
+	.enable_streams = cssp_bridge_enable_streams,
+	.disable_streams = cssp_bridge_disable_streams,
+};
+
+static const struct v4l2_subdev_ops cssp_bridge_ops = {
+	.video = &cssp_bridge_video_ops,
+	.pad = &cssp_bridge_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops cssp_bridge_internal_ops = {
+	.init_state = cssp_bridge_init_state,
+};
+
+static const struct media_entity_operations cssp_bridge_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+/* -----------------------------------------------------------------------------
+ * Orientation and async notifier
+ */
+
+/*
+ * A high orientation input means a back-facing sensor board. As the 3.8
+ * driver did, set the initial VFLIP value on the first subdev upstream of
+ * the bridge that has the control; userspace can change it later.
+ */
+static void cssp_apply_orientation(struct cssp_camif *c)
+{
+	struct media_entity *entity = &c->bridge.entity;
+	struct v4l2_ctrl *ctrl = NULL;
+	int val, ret;
+
+	if (!c->orient)
+		return;
+
+	val = gpiod_get_value_cansleep(c->orient);
+	if (val < 0) {
+		dev_warn(c->dev, "cannot read the orientation input: %d\n", val);
+		return;
+	}
+	dev_dbg(c->dev, "sensor faces the %s\n", val ? "back" : "front");
+	if (!val)
+		return;
+
+	scoped_guard(mutex, &c->mdev.graph_mutex) {
+		for (;;) {
+			struct media_pad *remote = NULL;
+			struct v4l2_subdev *sd;
+			unsigned int i;
+
+			for (i = 0; i < entity->num_pads; i++) {
+				if (!(entity->pads[i].flags & MEDIA_PAD_FL_SINK))
+					continue;
+				remote = media_pad_remote_pad_first(&entity->pads[i]);
+				if (remote)
+					break;
+			}
+			if (!remote ||
+			    !is_media_entity_v4l2_subdev(remote->entity))
+				break;
+
+			entity = remote->entity;
+			sd = media_entity_to_v4l2_subdev(entity);
+			ctrl = v4l2_ctrl_find(sd->ctrl_handler, V4L2_CID_VFLIP);
+			if (ctrl)
+				break;
+		}
+	}
+
+	if (!ctrl) {
+		dev_warn(c->dev, "back-facing sensor, but no VFLIP control found\n");
+		return;
+	}
+
+	ret = v4l2_ctrl_s_ctrl(ctrl, 1);
+	if (ret)
+		dev_warn(c->dev, "failed to set VFLIP: %d\n", ret);
+}
+
+static int cssp_notify_bound(struct v4l2_async_notifier *notifier,
+			     struct v4l2_subdev *sd,
+			     struct v4l2_async_connection *asc)
+{
+	struct cssp_camif *c = notifier_to_cssp(notifier);
+	struct device_link *link = NULL;
+	int pad, ret;
+
+	guard(mutex)(&c->vlock);
+
+	if (c->source)
+		return -EBUSY;
+
+	pad = media_entity_get_fwnode_pad(&sd->entity, asc->match.fwnode,
+					  MEDIA_PAD_FL_SOURCE);
+	if (pad < 0) {
+		dev_err(c->dev, "no source pad on %s: %d\n", sd->name, pad);
+		return pad;
+	}
+
+	ret = media_create_pad_link(&sd->entity, pad, &c->bridge.entity,
+				    CSSP_PAD_SINK, MEDIA_LNK_FL_ENABLED |
+				    MEDIA_LNK_FL_IMMUTABLE);
+	if (ret) {
+		dev_err(c->dev, "failed to link %s: %d\n", sd->name, ret);
+		return ret;
+	}
+
+	/*
+	 * Resuming the sensor resumes the bridge first, and system sleep is
+	 * ordered. No DL_FLAG_RPM_ACTIVE: it would keep the bridge powered
+	 * until the sensor's next resume/suspend cycle if the sensor is
+	 * already suspended. The link is not a safety condition (no reset
+	 * pulse), so a failure only costs the PM coupling.
+	 */
+	if (sd->dev)
+		link = device_link_add(sd->dev, c->dev,
+				       DL_FLAG_STATELESS | DL_FLAG_PM_RUNTIME);
+	if (!link)
+		dev_warn(c->dev, "no device link to %s\n", sd->name);
+
+	c->source = sd;
+	c->source_pad = pad;
+	c->link = link;
+
+	dev_dbg(c->dev, "bound %s pad %d\n", sd->name, pad);
+
+	return 0;
+}
+
+static void cssp_notify_unbind(struct v4l2_async_notifier *notifier,
+			       struct v4l2_subdev *sd,
+			       struct v4l2_async_connection *asc)
+{
+	struct cssp_camif *c = notifier_to_cssp(notifier);
+
+	guard(mutex)(&c->vlock);
+
+	if (c->source != sd)
+		return;
+
+	/*
+	 * The stream cannot continue without its sensor, and the sensor's
+	 * pads may be freed once it is gone. Stop everything that touches
+	 * them now, while the sensor is still valid: the subdev streams and
+	 * the media pipeline, which writes to every pad in it when stopped.
+	 * The vlock held here serialises this against stop_streaming(),
+	 * which then only releases the rest.
+	 */
+	if (vb2_start_streaming_called(&c->queue) && !c->pipe_stopped) {
+		cssp_quiesce(c);
+		v4l2_subdev_disable_streams(&c->bridge, CSSP_PAD_SOURCE,
+					    BIT_ULL(0));
+		video_device_pipeline_stop(&c->vdev);
+		c->pipe_stopped = true;
+		vb2_queue_error(&c->queue);
+	}
+
+	if (c->link)
+		device_link_del(c->link);
+	c->link = NULL;
+	c->source = NULL;
+}
+
+static int cssp_notify_complete(struct v4l2_async_notifier *notifier)
+{
+	struct cssp_camif *c = notifier_to_cssp(notifier);
+	int ret;
+
+	ret = v4l2_device_register_subdev_nodes(&c->v4l2_dev);
+	if (ret)
+		return ret;
+
+	cssp_apply_orientation(c);
+
+	return 0;
+}
+
+static const struct v4l2_async_notifier_operations cssp_notify_ops = {
+	.bound = cssp_notify_bound,
+	.unbind = cssp_notify_unbind,
+	.complete = cssp_notify_complete,
+};
+
+/* -----------------------------------------------------------------------------
+ * Probe and remove
+ */
+
+static int cssp_parse_endpoint(struct cssp_camif *c)
+{
+	struct v4l2_fwnode_endpoint vep = { .bus_type = V4L2_MBUS_PARALLEL };
+	struct fwnode_handle *ep;
+	unsigned int flags;
+	int ret;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(c->dev), 0, 0, 0);
+	if (!ep)
+		return dev_err_probe(c->dev, -ENODEV, "no endpoint\n");
+
+	ret = v4l2_fwnode_endpoint_parse(ep, &vep);
+	fwnode_handle_put(ep);
+	if (ret)
+		return dev_err_probe(c->dev, ret, "invalid parallel endpoint\n");
+
+	flags = vep.bus.parallel.flags;
+	c->bus_width = vep.bus.parallel.bus_width ?: 8;
+	if (c->bus_width != 8 && c->bus_width != 10)
+		return dev_err_probe(c->dev, -EINVAL, "unsupported bus width %u\n",
+				     c->bus_width);
+
+	/* HS_EN was always set by the 3.8 driver */
+	c->mode = CSSP_MODE_HS_EN;
+	if (c->bus_width == 8)
+		c->mode |= CSSP_MODE_FMT_2X8_EN;
+	else
+		dev_warn(c->dev, "10-bit bus mode was never tested\n");
+
+	/* falling edge unless the endpoint asks for the rising edge */
+	c->pclk_falling = !(flags & V4L2_MBUS_PCLK_SAMPLE_RISING);
+	if (c->pclk_falling)
+		c->mode |= CSSP_MODE_PCLK_POL;
+
+	/* hsync/vsync: no bridge setting, the binding allows active high only */
+	return 0;
+}
+
+static int cssp_async_init(struct cssp_camif *c)
+{
+	struct v4l2_async_connection *asc;
+	struct fwnode_handle *ep;
+	int ret;
+
+	v4l2_async_nf_init(&c->notifier, &c->v4l2_dev);
+	c->notifier.ops = &cssp_notify_ops;
+
+	ep = fwnode_graph_get_endpoint_by_id(dev_fwnode(c->dev), 0, 0, 0);
+	if (!ep)
+		return -ENODEV;
+
+	asc = v4l2_async_nf_add_fwnode_remote(&c->notifier, ep,
+					      struct v4l2_async_connection);
+	fwnode_handle_put(ep);
+	if (IS_ERR(asc))
+		return PTR_ERR(asc);
+
+	ret = v4l2_async_nf_register(&c->notifier);
+	if (ret)
+		dev_err(c->dev, "failed to register the notifier: %d\n", ret);
+
+	return ret;
+}
+
+static int cssp_bridge_init(struct cssp_camif *c)
+{
+	struct v4l2_subdev *sd = &c->bridge;
+	int ret;
+
+	v4l2_subdev_init(sd, &cssp_bridge_ops);
+	sd->internal_ops = &cssp_bridge_internal_ops;
+	sd->flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sd->entity.function = MEDIA_ENT_F_VID_IF_BRIDGE;
+	sd->entity.ops = &cssp_bridge_entity_ops;
+	sd->owner = THIS_MODULE;
+	sd->dev = c->dev;
+	strscpy(sd->name, CSSP_DRV_NAME, sizeof(sd->name));
+	v4l2_set_subdevdata(sd, c);
+
+	c->bridge_pads[CSSP_PAD_SINK].flags = MEDIA_PAD_FL_SINK;
+	c->bridge_pads[CSSP_PAD_SOURCE].flags = MEDIA_PAD_FL_SOURCE;
+	ret = media_entity_pads_init(&sd->entity, CSSP_NUM_PADS, c->bridge_pads);
+	if (ret)
+		return ret;
+
+	ret = v4l2_subdev_init_finalize(sd);
+	if (ret)
+		return ret;
+
+	return v4l2_device_register_subdev(&c->v4l2_dev, sd);
+}
+
+static int cssp_video_init(struct cssp_camif *c)
+{
+	struct video_device *vdev = &c->vdev;
+	struct vb2_queue *q = &c->queue;
+	int ret;
+
+	c->fmt.pixelformat = cssp_formats[0].fourcc;
+	c->fmt.width = CSSP_DEF_WIDTH;
+	c->fmt.height = CSSP_DEF_HEIGHT;
+	cssp_try_fmt(c, &c->fmt, &c->cfmt);
+
+	q->type = V4L2_BUF_TYPE_VIDEO_CAPTURE;
+	q->io_modes = VB2_MMAP | VB2_DMABUF;
+	q->drv_priv = c;
+	q->buf_struct_size = sizeof(struct cssp_buffer);
+	q->ops = &cssp_qops;
+	/* the DMA writes the bounce ring; the CPU copies into the buffers */
+	q->mem_ops = &vb2_vmalloc_memops;
+	q->timestamp_flags = V4L2_BUF_FLAG_TIMESTAMP_MONOTONIC |
+			     V4L2_BUF_FLAG_TSTAMP_SRC_EOF;
+	q->min_queued_buffers = 1;
+	q->lock = &c->vlock;
+	q->dev = c->dev;
+	ret = vb2_queue_init(q);
+	if (ret)
+		return ret;
+
+	strscpy(vdev->name, CSSP_DRV_NAME " capture", sizeof(vdev->name));
+	vdev->fops = &cssp_fops;
+	vdev->ioctl_ops = &cssp_ioctl_ops;
+	/* the structure is freed by the v4l2_device release */
+	vdev->release = video_device_release_empty;
+	vdev->v4l2_dev = &c->v4l2_dev;
+	vdev->queue = q;
+	vdev->lock = &c->vlock;
+	vdev->vfl_dir = VFL_DIR_RX;
+	vdev->device_caps = V4L2_CAP_VIDEO_CAPTURE | V4L2_CAP_STREAMING |
+			    V4L2_CAP_IO_MC;
+	vdev->entity.function = MEDIA_ENT_F_IO_V4L;
+	vdev->entity.ops = &cssp_video_entity_ops;
+	video_set_drvdata(vdev, c);
+
+	c->vdev_pad.flags = MEDIA_PAD_FL_SINK;
+	ret = media_entity_pads_init(&vdev->entity, 1, &c->vdev_pad);
+	if (ret)
+		return ret;
+
+	ret = video_register_device(vdev, VFL_TYPE_VIDEO, -1);
+	if (ret)
+		return ret;
+
+	ret = media_create_pad_link(&c->bridge.entity, CSSP_PAD_SOURCE,
+				    &vdev->entity, 0, MEDIA_LNK_FL_ENABLED |
+				    MEDIA_LNK_FL_IMMUTABLE);
+	if (ret)
+		vb2_video_unregister_device(vdev);
+
+	return ret;
+}
+
+/* Last reference to the V4L2 device gone: no file is open any more */
+static void cssp_v4l2_release(struct v4l2_device *v4l2_dev)
+{
+	struct cssp_camif *c = container_of(v4l2_dev, struct cssp_camif,
+					    v4l2_dev);
+
+	v4l2_subdev_cleanup(&c->bridge);
+	media_entity_cleanup(&c->bridge.entity);
+	media_entity_cleanup(&c->vdev.entity);
+	media_device_cleanup(&c->mdev);
+	mutex_destroy(&c->hw_lock);
+	mutex_destroy(&c->vlock);
+	kfree(c);
+}
+
+static void cssp_put_dma(struct cssp_camif *c)
+{
+	dma_unmap_resource(c->dmadev, c->data_dma, CSSP_DATA_WINDOW,
+			   DMA_FROM_DEVICE, 0);
+	dma_release_channel(c->dma);
+}
+
+static void cssp_pm_disable(struct cssp_camif *c)
+{
+	pm_runtime_disable(c->dev);
+	if (!pm_runtime_status_suspended(c->dev))
+		cssp_power_off(c);
+	pm_runtime_set_suspended(c->dev);
+	pm_runtime_dont_use_autosuspend(c->dev);
+}
+
+/*
+ * Registers, GPIOs, regulators and the clock are device managed: nothing
+ * touches them after remove, because remove stops streaming and powers the
+ * bridge down first. The DMA channel and the data port mapping are released
+ * by hand (cssp_put_dma()), because a devres action would run after remove
+ * and the driver state, which it needs, may be gone by then: the state lives
+ * until the last file is closed.
+ */
+static int cssp_get_resources(struct cssp_camif *c,
+			      struct platform_device *pdev)
+{
+	struct device *dev = c->dev;
+	struct resource *res;
+	int ret;
+
+	c->base = devm_platform_get_and_ioremap_resource(pdev, 0, &res);
+	if (IS_ERR(c->base))
+		return PTR_ERR(c->base);
+	if (resource_size(res) < CSSP_REG_DATA + CSSP_DATA_WINDOW)
+		return dev_err_probe(dev, -EINVAL, "register window too small\n");
+	c->data_phys = res->start + CSSP_REG_DATA;
+
+	/*
+	 * Logically deasserted, i.e. the line is high and the bridge and the
+	 * sensor stay out of reset. The driver owns the line so that nothing
+	 * else drives it, and never pulses it.
+	 */
+	c->reset = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(c->reset))
+		return dev_err_probe(dev, PTR_ERR(c->reset),
+				     "failed to get the reset GPIO\n");
+
+	c->orient = devm_gpiod_get_optional(dev, "orientation", GPIOD_IN);
+	if (IS_ERR(c->orient))
+		return dev_err_probe(dev, PTR_ERR(c->orient),
+				     "failed to get the orientation GPIO\n");
+
+	c->supplies[0].supply = "vdd";
+	c->supplies[1].supply = "vddio";
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(c->supplies),
+				      c->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get the supplies\n");
+
+	c->mclk = devm_clk_get_optional(dev, NULL);
+	if (IS_ERR(c->mclk))
+		return dev_err_probe(dev, PTR_ERR(c->mclk),
+				     "failed to get the clock\n");
+
+	c->dma = dma_request_chan(dev, "rx");
+	if (IS_ERR(c->dma))
+		return dev_err_probe(dev, PTR_ERR(c->dma),
+				     "failed to get the DMA channel\n");
+
+	c->dmadev = dmaengine_get_dma_device(c->dma);
+
+	/* the data port as the DMA controller sees it */
+	c->data_dma = dma_map_resource(c->dmadev, c->data_phys,
+				       CSSP_DATA_WINDOW, DMA_FROM_DEVICE, 0);
+	if (dma_mapping_error(c->dmadev, c->data_dma)) {
+		dma_release_channel(c->dma);
+		return dev_err_probe(dev, -ENOMEM,
+				     "failed to map the data port\n");
+	}
+	dev_dbg(dev, "data port %pa, DMA address %pad\n", &c->data_phys,
+		&c->data_dma);
+
+	return 0;
+}
+
+static int cssp_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct cssp_camif *c;
+	int ret;
+
+	/* freed by cssp_v4l2_release() once the V4L2 device is registered */
+	c = kzalloc_obj(*c);
+	if (!c)
+		return -ENOMEM;
+
+	c->dev = dev;
+	mutex_init(&c->vlock);
+	mutex_init(&c->hw_lock);
+	spin_lock_init(&c->qlock);
+	INIT_LIST_HEAD(&c->pending);
+	INIT_WORK(&c->copy_work, cssp_copy_work);
+	INIT_WORK(&c->recover_work, cssp_recover_work);
+	INIT_DELAYED_WORK(&c->watchdog, cssp_watchdog_work);
+	/* before v4l2_device_register(), which would set its own drvdata */
+	platform_set_drvdata(pdev, c);
+
+	ret = cssp_get_resources(c, pdev);
+	if (ret)
+		goto err_free;
+
+	ret = cssp_parse_endpoint(c);
+	if (ret)
+		goto err_dma;
+
+	c->copy_wq = alloc_ordered_workqueue(CSSP_DRV_NAME, WQ_HIGHPRI);
+	if (!c->copy_wq) {
+		ret = -ENOMEM;
+		goto err_dma;
+	}
+
+	/*
+	 * Power up by hand and hand the active state to runtime PM, so that
+	 * the driver also identifies the bridge when runtime PM is not
+	 * enabled yet. The driver never pulses the reset.
+	 */
+	ret = cssp_power_on(c);
+	if (ret)
+		goto err_wq;
+
+	ret = cssp_identify(c);
+	if (ret) {
+		cssp_power_off(c);
+		goto err_wq;
+	}
+
+	dev_info(dev, "CSSP revision %c%u, %u-byte requests\n",
+		 'A' + (c->rev >> 4), c->rev & 0xf, c->req_len);
+
+	pm_runtime_set_active(dev);
+	pm_runtime_get_noresume(dev);
+	pm_runtime_set_autosuspend_delay(dev, CSSP_AUTOSUSPEND_MS);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_enable(dev);
+	pm_runtime_put_autosuspend(dev);
+
+	c->mdev.dev = dev;
+	strscpy(c->mdev.model, CSSP_MODEL, sizeof(c->mdev.model));
+	/* must match the libcamera simple pipeline table */
+	strscpy(c->mdev.driver_name, CSSP_DRV_NAME, sizeof(c->mdev.driver_name));
+	media_device_init(&c->mdev);
+
+	c->v4l2_dev.mdev = &c->mdev;
+	c->v4l2_dev.release = cssp_v4l2_release;
+	ret = v4l2_device_register(dev, &c->v4l2_dev);
+	if (ret) {
+		media_device_cleanup(&c->mdev);
+		goto err_pm;
+	}
+
+	/* from here on, v4l2_device_put() frees the state */
+	ret = cssp_bridge_init(c);
+	if (ret)
+		goto err_v4l2;
+
+	ret = cssp_video_init(c);
+	if (ret)
+		goto err_bridge;
+
+	ret = cssp_async_init(c);
+	if (ret)
+		goto err_async;
+
+	ret = media_device_register(&c->mdev);
+	if (ret)
+		goto err_async;
+
+	return 0;
+
+err_async:
+	v4l2_async_nf_unregister(&c->notifier);
+	v4l2_async_nf_cleanup(&c->notifier);
+	vb2_video_unregister_device(&c->vdev);
+err_bridge:
+	v4l2_device_unregister_subdev(&c->bridge);
+err_v4l2:
+	v4l2_device_unregister(&c->v4l2_dev);
+	cssp_pm_disable(c);
+	destroy_workqueue(c->copy_wq);
+	cssp_put_dma(c);
+	v4l2_device_put(&c->v4l2_dev);
+	return ret;
+
+err_pm:
+	cssp_pm_disable(c);
+err_wq:
+	destroy_workqueue(c->copy_wq);
+err_dma:
+	cssp_put_dma(c);
+err_free:
+	mutex_destroy(&c->hw_lock);
+	mutex_destroy(&c->vlock);
+	kfree(c);
+	return ret;
+}
+
+static void cssp_remove(struct platform_device *pdev)
+{
+	struct cssp_camif *c = platform_get_drvdata(pdev);
+
+	/* stops a running stream; later file operations do not reach the driver */
+	vb2_video_unregister_device(&c->vdev);
+	/* unbinds the sensor, which removes the device link */
+	v4l2_async_nf_unregister(&c->notifier);
+	v4l2_async_nf_cleanup(&c->notifier);
+	media_device_unregister(&c->mdev);
+	v4l2_device_unregister_subdev(&c->bridge);
+	v4l2_device_unregister(&c->v4l2_dev);
+
+	destroy_workqueue(c->copy_wq);
+	cssp_pm_disable(c);
+	cssp_put_dma(c);
+
+	/* the GPMC chip select belongs to the GPMC driver */
+	v4l2_device_put(&c->v4l2_dev);
+}
+
+static const struct of_device_id cssp_of_match[] = {
+	{ .compatible = "quicklogic,cssp-camif" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, cssp_of_match);
+
+static struct platform_driver cssp_driver = {
+	.probe = cssp_probe,
+	.remove = cssp_remove,
+	.driver = {
+		.name = CSSP_DRV_NAME,
+		.of_match_table = cssp_of_match,
+		.pm = pm_ptr(&cssp_pm_ops),
+	},
+};
+module_platform_driver(cssp_driver);
+
+MODULE_DESCRIPTION("QuickLogic CSSP camera interface driver");
+MODULE_AUTHOR("Koen Kooi <koen@dominion.thruhere.net>");
+MODULE_LICENSE("GPL");
