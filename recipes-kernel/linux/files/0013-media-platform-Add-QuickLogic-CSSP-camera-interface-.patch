+/* -----------------------------------------------------------------------------
+ * Video node
+ */
+
+static void cssp_try_fmt(const struct cssp_camif *c,
+			 struct v4l2_pix_format *pix,
+			 const struct cssp_format **cfmt)
+{
+	const struct cssp_format *f = cssp_find_fourcc(c, pix->pixelformat);
+
+	if (!f)
+		f = &cssp_formats[0];
+
+	/* the size is kept as requested within the limits (libcamera needs it) */
+	pix->pixelformat = f->fourcc;
+	pix->width = clamp(pix->width, CSSP_MIN_WIDTH, CSSP_MAX_WIDTH);
+	pix->height = clamp(pix->height, CSSP_MIN_HEIGHT, CSSP_MAX_HEIGHT);
+	pix->field = V4L2_FIELD_NONE;
+	pix->bytesperline = pix->width * f->bpp;
+	pix->sizeimage = pix->bytesperline * pix->height;
+	/* the bridge passes the data through and cannot convert colorspaces */
+	pix->colorspace = f->raw ? V4L2_COLORSPACE_RAW : V4L2_COLORSPACE_SRGB;
+	pix->ycbcr_enc = V4L2_YCBCR_ENC_DEFAULT;
+	pix->quantization = V4L2_QUANTIZATION_DEFAULT;
+	pix->xfer_func = V4L2_XFER_FUNC_DEFAULT;
+	pix->flags = 0;
+
+	if (cfmt)
+		*cfmt = f;
+}
+
+static int cssp_querycap(struct file *file, void *fh,
+			 struct v4l2_capability *cap)
+{
+	strscpy(cap->driver, CSSP_DRV_NAME, sizeof(cap->driver));
+	strscpy(cap->card, CSSP_MODEL, sizeof(cap->card));
+
+	return 0;
+}
+
+static int cssp_enum_fmt(struct file *file, void *fh, struct v4l2_fmtdesc *f)
+{
+	struct cssp_camif *c = video_drvdata(file);
+	const struct cssp_format *fmt;
+
+	if (f->mbus_code) {
+		/* the video node sits behind the bridge source pad */
+		fmt = cssp_find_src_code(c, f->mbus_code);
+		if (!fmt || f->index)
+			return -EINVAL;
+	} else {
+		fmt = cssp_nth_format(c, f->index);
+		if (!fmt)
+			return -EINVAL;
+	}
+
+	f->pixelformat = fmt->fourcc;
+
+	return 0;
+}
+
+static int cssp_enum_framesizes(struct file *file, void *fh,
+				struct v4l2_frmsizeenum *fsize)
+{
+	if (fsize->index ||
+	    !cssp_find_fourcc(video_drvdata(file), fsize->pixel_format))
+		return -EINVAL;
+
+	fsize->type = V4L2_FRMSIZE_TYPE_STEPWISE;
+	fsize->stepwise.min_width = CSSP_MIN_WIDTH;
+	fsize->stepwise.max_width = CSSP_MAX_WIDTH;
+	fsize->stepwise.step_width = 1;
+	fsize->stepwise.min_height = CSSP_MIN_HEIGHT;
+	fsize->stepwise.max_height = CSSP_MAX_HEIGHT;
+	fsize->stepwise.step_height = 1;
+
+	return 0;
+}
+
+static int cssp_g_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct cssp_camif *c = video_drvdata(file);
+
+	f->fmt.pix = c->fmt;
+
+	return 0;
+}
+
+static int cssp_try_fmt_vid_cap(struct file *file, void *fh,
+				struct v4l2_format *f)
+{
+	cssp_try_fmt(video_drvdata(file), &f->fmt.pix, NULL);
+
+	return 0;
+}
+
+static int cssp_s_fmt(struct file *file, void *fh, struct v4l2_format *f)
+{
+	struct cssp_camif *c = video_drvdata(file);
+
+	if (vb2_is_busy(&c->queue))
+		return -EBUSY;
+
+	cssp_try_fmt(c, &f->fmt.pix, &c->cfmt);
+	c->fmt = f->fmt.pix;
+
+	return 0;
+}
+
+static const struct v4l2_ioctl_ops cssp_ioctl_ops = {
+	.vidioc_querycap = cssp_querycap,
+	.vidioc_enum_fmt_vid_cap = cssp_enum_fmt,
+	.vidioc_enum_framesizes = cssp_enum_framesizes,
+	.vidioc_g_fmt_vid_cap = cssp_g_fmt,
+	.vidioc_try_fmt_vid_cap = cssp_try_fmt_vid_cap,
+	.vidioc_s_fmt_vid_cap = cssp_s_fmt,
+	.vidioc_reqbufs = vb2_ioctl_reqbufs,
+	.vidioc_create_bufs = vb2_ioctl_create_bufs,
+	.vidioc_prepare_buf = vb2_ioctl_prepare_buf,
+	.vidioc_querybuf = vb2_ioctl_querybuf,
+	.vidioc_qbuf = vb2_ioctl_qbuf,
+	.vidioc_dqbuf = vb2_ioctl_dqbuf,
+	.vidioc_expbuf = vb2_ioctl_expbuf,
+	.vidioc_streamon = vb2_ioctl_streamon,
+	.vidioc_streamoff = vb2_ioctl_streamoff,
+};
