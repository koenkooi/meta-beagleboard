+/************************************************************************
+ *			v4l2_ctrl_ops
+ ***********************************************************************/
+static int mt9t112_s_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct mt9t112_priv *priv =
+		container_of(ctrl->handler, struct mt9t112_priv, hdl);
+	struct device *dev = &priv->client->dev;
+	unsigned int flip;
+	int ret = 0;
+
+	/*
+	 * The values are applied when streaming starts, the sensor is
+	 * initialised then. Only a powered sensor takes them live.
+	 */
+	if (!pm_runtime_get_if_in_use(dev))
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		flip = priv->hflip->val | (priv->vflip->val << 1);
+		if (flip != priv->flip_applied) {
+			ret = mt9t112_set_orientation(priv->client, flip);
+			if (!ret)
+				priv->flip_applied = flip;
+		}
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = mt9t112_set_test_pattern(priv, ctrl->val);
+		break;
+	default:
+		break;
+	}
+
+	pm_runtime_put_autosuspend(dev);
+
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops mt9t112_ctrl_ops = {
+	.s_ctrl = mt9t112_s_ctrl,
+};
+
+static int mt9t112_init_controls(struct mt9t112_priv *priv)
+{
+	struct v4l2_ctrl_handler *hdl = &priv->hdl;
+	struct v4l2_fwnode_device_properties props;
+	struct v4l2_ctrl *ctrl;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 8);
+
+	priv->hflip = v4l2_ctrl_new_std(hdl, &mt9t112_ctrl_ops,
+					V4L2_CID_HFLIP, 0, 1, 1, 0);
+	priv->vflip = v4l2_ctrl_new_std(hdl, &mt9t112_ctrl_ops,
+					V4L2_CID_VFLIP, 0, 1, 1, 0);
+	v4l2_ctrl_cluster(2, &priv->hflip);
+
+	priv->test_pattern =
+		v4l2_ctrl_new_std_menu_items(hdl, &mt9t112_ctrl_ops,
+					     V4L2_CID_TEST_PATTERN,
+					     ARRAY_SIZE(mt9t112_test_pattern_menu) - 1,
+					     0, 0, mt9t112_test_pattern_menu);
+
+	/*
+	 * The bus carries two clocks per pixel. The values are only known when
+	 * the PLL settings were derived from the clock rate.
+	 */
+	if (priv->pll.pclk) {
+		priv->link_freq = priv->pll.pclk;
+		ctrl = v4l2_ctrl_new_int_menu(hdl, &mt9t112_ctrl_ops,
+					      V4L2_CID_LINK_FREQ, 0, 0,
+					      &priv->link_freq);
+		if (ctrl)
+			ctrl->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+		v4l2_ctrl_new_std(hdl, &mt9t112_ctrl_ops, V4L2_CID_PIXEL_RATE,
+				  priv->pll.pclk / 2, priv->pll.pclk / 2, 1,
+				  priv->pll.pclk / 2);
+	}
+
+	if (dev_fwnode(&priv->client->dev)) {
+		ret = v4l2_fwnode_device_parse(&priv->client->dev, &props);
+		if (ret)
+			goto err_free;
+
+		ret = v4l2_ctrl_new_fwnode_properties(hdl, &mt9t112_ctrl_ops,
+						      &props);
+		if (ret)
+			goto err_free;
+	}
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free;
 	}
 
 	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(hdl);
+
+	return ret;
 }
 
