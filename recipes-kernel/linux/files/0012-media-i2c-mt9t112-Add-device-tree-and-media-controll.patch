+/**
+ * mt9t112_select_pll() - Select the PLL settings for the current clock rate
+ * @priv: the sensor
+ *
+ * A rate listed in the built-in table (within 1%) always wins. Platform data
+ * users with another rate, or without a clock, keep supplying their own
+ * dividers.
+ *
+ * Return: 0 on success, -EINVAL if the clock rate is not supported.
+ */
+static int mt9t112_select_pll(struct mt9t112_priv *priv)
+{
+	struct device *dev = &priv->client->dev;
+	unsigned long rate = priv->clk ? clk_get_rate(priv->clk) : 0;
+	struct mt9t112_pll *pll = &priv->pll;
+	unsigned int i;
+
+	memset(pll, 0, sizeof(*pll));
+
+	for (i = 0; rate && i < ARRAY_SIZE(mt9t112_plls); i++) {
+		unsigned long ref = mt9t112_plls[i].extclk;
+
+		if (abs_diff(rate, ref) > ref / 100)
+			continue;
+
+		pll->extclk = ref;
+		pll->div = mt9t112_plls[i].div;
+		break;
+	}
+
+	if (!pll->extclk) {
+		if (!priv->info) {
+			dev_err(dev, "unsupported external clock rate %lu Hz\n",
+				rate);
+			return -EINVAL;
+		}
+
+		/* Legacy platform data: dividers come from the board file. */
+		pll->extclk = rate;
+		pll->div = priv->info->divider;
+	}
+
+	/* Reference clock count for 20 us, 0x0190 at 20 MHz. */
+	pll->refcnt = pll->extclk ? pll->extclk / 50000 : 0x0190;
+
+	if (pll->extclk) {
+		u64 vco = div_u64((u64)2 * pll->div.m * pll->extclk,
+				  pll->div.n + 1);
+
+		pll->pclk = div_u64(vco, (pll->div.p1 + 1) * (pll->div.p2 + 1));
+	}
+
+	return 0;
+}
+
+/**
+ * mt9t112_wait_ready() - Wait until the chip answers on the I2C bus
+ * @client: the I2C client
+ *
+ * Return: the chip ID register value or a negative error code.
+ */
+static int mt9t112_wait_ready(const struct i2c_client *client)
+{
+	int chipid = -ENODEV;
+	int i;
+
+	for (i = 0; i < 10; i++) {
+		chipid = __mt9t112_reg_read(client, 0x0000);
+		if (chipid >= 0)
+			return chipid;
+
+		usleep_range(10000, 15000);
+	}
+
+	return chipid;
+}
