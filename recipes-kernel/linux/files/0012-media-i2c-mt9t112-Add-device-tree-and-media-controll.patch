 	ECHECKER(ret, mt9t112_reset(client));
 	ECHECKER(ret, mt9t112_init_pll(client));
 	ECHECKER(ret, mt9t112_init_setting(client));
@@ -713,175 +901,451 @@ static int mt9t112_init_camera(const struct i2c_client *client)
