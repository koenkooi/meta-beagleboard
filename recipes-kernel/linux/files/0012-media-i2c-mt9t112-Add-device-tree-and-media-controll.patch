+/*
+ * The colour bar uses VAR(24, 0x03) = 0x100 and VAR(24, 0x25) = 0x0B (from the
+ * out of tree driver's TEST_PATTERN option, whose comment doubts the second
+ * value). The power-on values are not documented, so they are read back
+ * before the first change and restored when the pattern is switched off.
+ */
+static int mt9t112_set_test_pattern(struct mt9t112_priv *priv, int val)
 {
-	struct i2c_client *client = v4l2_get_subdevdata(sd);
+	const struct i2c_client *client = priv->client;
 	int ret;
 
-	mt9t112_reg_write(ret, client, reg->reg, reg->val);
+	if (val) {
+		if (!priv->tp_saved) {
+			ret = __mt9t112_mcu_read(client, VAR(24, 0x03));
+			if (ret < 0)
+				return ret;
+			priv->tp_saved_val[0] = ret;
+
+			ret = __mt9t112_mcu_read(client, VAR(24, 0x25));
+			if (ret < 0)
+				return ret;
+			priv->tp_saved_val[1] = ret;
+
+			priv->tp_saved = true;
+		}
+
+		mt9t112_mcu_write(ret, client, VAR(24, 0x03), 0x100);
+		mt9t112_mcu_write(ret, client, VAR(24, 0x25), 0x0B);
+	} else if (priv->tp_saved) {
+		mt9t112_mcu_write(ret, client, VAR(24, 0x03),
+				  priv->tp_saved_val[0]);
+		mt9t112_mcu_write(ret, client, VAR(24, 0x25),
+				  priv->tp_saved_val[1]);
+		priv->tp_saved = false;
+	} else {
+		return 0;
+	}
+
+	/* SEQ_CMD: refresh. */
+	mt9t112_mcu_write(ret, client, VAR8(1, 0), 0x06);
 
 	return ret;
 }
